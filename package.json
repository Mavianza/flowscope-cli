{
  "name": "@mavianza/flowscope-cli",
  "version": "1.0.0",
  "description": "Analisis aliran maksimum, potongan minimum, dan simulasi kapasitas graf dengan laporan SVG.",
  "type": "module",
  "bin": { "flowscope": "bin/flowscope.mjs" },
  "exports": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["bin", "dist", "examples", "docs", "VERIFICATION.md", "README.md", "LICENSE"],
  "engines": { "node": ">=22.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "demo": "node bin/flowscope.mjs solve examples/logistik.json --scenario examples/tambah-kapasitas.json",
    "verify:package": "node tools/verify-package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3"
  },
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Mavianza/flowscope-cli.git" }
}
